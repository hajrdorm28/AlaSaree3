@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-card">
    <div class="text-center mb-4">
        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
            <i class="bi bi-box-arrow-in-right fs-4"></i>
        </div>
        <h2 class="h4 fw-bold">Welcome Back</h2>
        <p class="text-muted small">Sign in to your AlaSaree3 account to manage orders, products, or store settings.</p>
    </div>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold small"></label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold small"></label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-4 form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
        </div>

        <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">
            <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
        </button>

        <div class="text-center small text-muted">
            Don't have an account? <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-primary fw-semibold text-decoration-none">Create one</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
