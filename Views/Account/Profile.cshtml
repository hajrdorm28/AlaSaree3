@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="custom-card p-4 text-center mb-4">
            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; font-size: 2rem; font-weight: 700;">
                @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : "U")
            </div>
            <h4 class="fw-bold mb-1">@Model.FullName</h4>
            <p class="text-muted small mb-2">@Model.Email</p>
            <div>
                <span class="badge @(Model.Role == "Admin" ? "bg-danger" : Model.Role == "Seller" ? "bg-warning text-dark" : "bg-info text-dark") px-3 py-2 rounded-pill">
                    <i class="bi bi-person-badge me-1"></i>Role: @Model.Role
                </span>
                <span class="badge @(Model.Status == UserStatus.Active ? "bg-success" : "bg-danger") px-3 py-2 rounded-pill ms-1">
                    @Model.Status
                </span>
            </div>
            <hr class="my-4">
            <div class="text-start small text-muted">
                <div class="d-flex justify-content-between mb-2">
                    <span>Member Since:</span>
                    <span class="fw-semibold text-dark">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Total Orders:</span>
                    <span class="fw-semibold text-dark">@Model.TotalOrders</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Wishlist Items:</span>
                    <span class="fw-semibold text-dark">@Model.WishlistCount</span>
                </div>
            </div>
        </div>

        @if (Model.Role == "Customer")
        {
            <div class="custom-card p-4">
                <h5 class="fw-bold mb-2"><i class="bi bi-shop text-primary me-2"></i>Become a Seller</h5>
                @if (Model.PendingSellerRequest != null)
                {
                    <div class="alert alert-warning mb-0 small">
                        <i class="bi bi-hourglass-split me-1"></i>Your seller application (<strong>@Model.PendingSellerRequest.BusinessName</strong>) is currently <strong>Pending Admin Review</strong> submitted on @Model.PendingSellerRequest.RequestedAt.ToString("MMM dd, yyyy").
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">Want to sell your own merchandise on AlaSaree3? Submit your store application for admin approval.</p>
                    <a asp-controller="Seller" asp-action="RequestSeller" class="btn btn-outline-primary btn-sm w-100">
                        <i class="bi bi-arrow-right-circle me-1"></i>Apply for Seller Account
                    </a>
                }
            </div>
        }
    </div>

    <div class="col-lg-8">
        <div class="custom-card p-4">
            <h4 class="fw-bold mb-4"><i class="bi bi-gear-wide-connected text-primary me-2"></i>Account Details</h4>
            
            <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold small"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small"></label>
                    <input asp-for="Email" class="form-control bg-light" readonly />
                    <div class="form-text small">Email address cannot be changed directly.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold small"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="+1-555-0123" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-primary-custom px-4">
                        <i class="bi bi-save me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
