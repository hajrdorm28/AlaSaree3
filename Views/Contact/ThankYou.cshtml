@{
    ViewData["Title"] = "Message Sent";
}

<div class="text-center py-5">
    <div class="display-1 text-success mb-3"><i class="bi bi-check-circle-fill"></i></div>
    <h1 class="h3 fw-bold text-dark mb-3">Message Sent</h1>
    <p class="text-muted mb-4">
        Thanks for reaching out. Your message has been delivered to our administrators and they'll get back to you
        at the email address you provided as soon as possible.
    </p>
    <div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom px-4 py-2">
            <i class="bi bi-house me-2"></i>Return to Homepage
        </a>
    </div>
</div>
