@model ContactCreateViewModel
@{
    ViewData["Title"] = "Contact Admin";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="custom-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                    <i class="bi bi-envelope-paper-fill fs-4"></i>
                </div>
                <h2 class="h4 fw-bold">Contact Admin</h2>
                <p class="text-muted small mb-0">Have a question, an issue, or need to appeal an account decision? Send our administrators a message below.</p>
            </div>

            @if (Model.IsSuspensionContext)
            {
                <div class="alert alert-warning d-flex align-items-start gap-2 mb-4">
                    <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                    <div class="small">
                        <strong>Your account has been suspended.</strong> If you believe this was a mistake or would like to
                        appeal, please describe your situation below and an administrator will review your case.
                    </div>
                </div>
            }

            <form asp-controller="Contact" asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IsSuspensionContext" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Ali Ahmed" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Reason" class="form-label fw-semibold small"></label>
                    <select asp-for="Reason" class="form-select" asp-items="Html.GetEnumSelectList<ContactReason>()"></select>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label fw-semibold small"></label>
                    <input asp-for="Subject" class="form-control" placeholder="Brief summary of your message" />
                    <span asp-validation-for="Subject" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Message" class="form-label fw-semibold small"></label>
                    <textarea asp-for="Message" class="form-control" rows="6" placeholder="Please provide as much detail as possible..."></textarea>
                    <span asp-validation-for="Message" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2">
                    <i class="bi bi-send-fill me-1"></i>Send Message
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
