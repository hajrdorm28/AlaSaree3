@model IEnumerable<SellerRequest>
@{
    ViewData["Title"] = "Seller Applications";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1"><i class="bi bi-person-check text-primary me-2"></i>Seller Applications</h2>
        <p class="text-muted small mb-0">Review, approve, or reject vendor requests from customers</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="custom-card p-5 text-center my-4">
        <i class="bi bi-check-all display-3 text-muted mb-3"></i>
        <h4 class="fw-bold">No Seller Applications</h4>
        <p class="text-muted mb-0">All submitted applications have been processed.</p>
    </div>
}
else
{
    <div class="custom-card p-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Applicant</th>
                        <th>Store Name</th>
                        <th>Reason / Description</th>
                        <th>Status</th>
                        <th class="text-end">Decision</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model)
                    {
                        var badgeClass = req.Status switch
                        {
                            RequestStatus.Pending => "bg-warning text-dark",
                            RequestStatus.Approved => "bg-success",
                            RequestStatus.Rejected => "bg-danger",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="small text-muted">@req.RequestedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="fw-semibold small">@req.User.FullName</div>
                                <div class="text-muted" style="font-size: 0.75rem;">@req.User.Email</div>
                                @if (!string.IsNullOrEmpty(req.PhoneNumber))
                                {
                                    <div class="text-muted" style="font-size: 0.75rem;">Phone: @req.PhoneNumber</div>
                                }
                            </td>
                            <td class="fw-bold text-dark">@req.BusinessName</td>
                            <td class="small text-secondary" style="max-width: 280px;">@req.Reason</td>
                            <td>
                                <span class="badge @badgeClass px-2 py-1 rounded-pill">@req.Status</span>
                            </td>
                            <td class="text-end">
                                @if (req.Status == RequestStatus.Pending)
                                {
                                    <div class="d-inline-flex gap-1">
                                        <form asp-action="ApproveSellerRequest" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@req.Id" />
                                            <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Approve this seller application and assign Seller role?');">
                                                <i class="bi bi-check-lg"></i> Approve
                                            </button>
                                        </form>
                                        <form asp-action="RejectSellerRequest" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@req.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Reject this seller application?');">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Processed on @(req.ReviewedAt?.ToString("MMM dd, yyyy") ?? "-")</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
