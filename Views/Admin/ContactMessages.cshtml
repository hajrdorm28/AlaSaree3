@model IEnumerable<ContactMessage>
@{
    ViewData["Title"] = "Messages";
    var selectedStatus = ViewBag.SelectedStatus as ContactMessageStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1"><i class="bi bi-envelope-open text-primary me-2"></i>Messages</h2>
        <p class="text-muted small mb-0">Messages sent by visitors and users, including suspended-account appeals</p>
    </div>
</div>

<!-- Filters -->
<div class="custom-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                <option value="@ContactMessageStatus.New" selected="@(selectedStatus == ContactMessageStatus.New)">New</option>
                <option value="@ContactMessageStatus.InProgress" selected="@(selectedStatus == ContactMessageStatus.InProgress)">In Progress</option>
                <option value="@ContactMessageStatus.Resolved" selected="@(selectedStatus == ContactMessageStatus.Resolved)">Resolved</option>
            </select>
        </div>
    </form>
</div>

<div class="custom-card p-4">
    @if (!Model.Any())
    {
        <p class="text-muted small text-center py-4">No contact messages found.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var msg in Model)
            {
                var badgeClass = msg.Status switch
                {
                    ContactMessageStatus.New => "bg-danger",
                    ContactMessageStatus.InProgress => "bg-warning text-dark",
                    ContactMessageStatus.Resolved => "bg-success",
                    _ => "bg-secondary"
                };

                <div class="p-3 bg-light rounded-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
                        <div>
                            <span class="fw-bold text-dark">@msg.Subject</span>
                            @if (msg.Reason == ContactReason.AccountSuspension)
                            {
                                <span class="badge bg-danger ms-2"><i class="bi bi-shield-x me-1"></i>Suspension Appeal</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary ms-2">@msg.Reason</span>
                            }
                        </div>
                        <span class="badge @badgeClass">@msg.Status</span>
                    </div>
                    <p class="small text-muted mb-1">
                        From: <strong>@msg.Name</strong> (@msg.Email)
                        @if (msg.User != null)
                        {
                            <span class="text-info">— Registered user: @msg.User.FullName</span>
                        }
                        <span class="ms-2">@msg.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </p>
                    <p class="small text-secondary mb-3" style="white-space: pre-wrap;">@msg.Message</p>

                    @if (!string.IsNullOrEmpty(msg.AdminNotes))
                    {
                        <div class="alert alert-secondary small py-2 mb-3">
                            <strong>Admin Notes:</strong> @msg.AdminNotes
                        </div>
                    }

                    @if (msg.Status != ContactMessageStatus.Resolved)
                    {
                        <div class="d-flex flex-wrap gap-2 align-items-start">
                            @if (msg.Status == ContactMessageStatus.New)
                            {
                                <form asp-action="MarkContactMessageInProgress" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@msg.Id" />
                                    <button type="submit" class="btn btn-outline-warning btn-sm">
                                        <i class="bi bi-hourglass-split me-1"></i>Mark In Progress
                                    </button>
                                </form>
                            }
                            <form asp-action="ResolveContactMessage" method="post" class="d-flex gap-2 flex-grow-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@msg.Id" />
                                <input type="text" name="adminNotes" class="form-control form-control-sm" placeholder="Optional resolution notes..." style="max-width: 320px;" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-check-lg me-1"></i>Resolve
                                </button>
                            </form>
                        </div>
                    }
                    else if (msg.ResolvedAt.HasValue)
                    {
                        <p class="small text-success mb-0"><i class="bi bi-check-circle me-1"></i>Resolved on @msg.ResolvedAt.Value.ToString("MMM dd, yyyy HH:mm")</p>
                    }
                </div>
            }
        </div>
    }
</div>
