@model UserManagementViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>User Governance</h2>
        <p class="text-muted small mb-0">Manage customer accounts, seller authorizations, and enforce suspension policies</p>
    </div>
</div>

<!-- Filters Card -->
<div class="custom-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Search by name or email..." value="@Model.SearchTerm" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="role" class="form-select">
                <option value="">All Roles</option>
                <option value="Customer" selected="@(Model.SelectedRole == "Customer")">Customer</option>
                <option value="Seller" selected="@(Model.SelectedRole == "Seller")">Seller</option>
                <option value="Admin" selected="@(Model.SelectedRole == "Admin")">Admin</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="@UserStatus.Active" selected="@(Model.SelectedStatus == UserStatus.Active)">Active</option>
                <option value="@UserStatus.Suspended" selected="@(Model.SelectedStatus == UserStatus.Suspended)">Suspended</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary-custom w-100">Filter</button>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="custom-card p-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Account Status</th>
                    <th>Registered</th>
                    <th>Activity</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-weight: 700;">
                                    @(user.FullName.Length > 0 ? user.FullName.Substring(0, 1).ToUpper() : "U")
                                </div>
                                <div>
                                    <div class="fw-semibold">@user.FullName</div>
                                    <div class="text-muted small">@user.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge @(user.Role == "Admin" ? "bg-danger" : user.Role == "Seller" ? "bg-warning text-dark" : "bg-info text-dark") px-2 py-1 rounded-pill">
                                @user.Role
                            </span>
                        </td>
                        <td>
                            <span class="badge @(user.Status == UserStatus.Active ? "bg-success" : "bg-danger") px-2 py-1 rounded-pill">
                                @user.Status
                            </span>
                        </td>
                        <td class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="small text-muted">
                            @if (user.Role == "Seller")
                            {
                                <span>@user.ProductCount Products Listed</span>
                            }
                            else
                            {
                                <span>@user.OrderCount Orders Placed</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (user.Email == "admin@alasaree3.com")
                            {
                                <span class="badge bg-secondary">System Admin</span>
                            }
                            else
                            {
                                <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    @if (user.Status == UserStatus.Active)
                                    {
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to suspend user @user.FullName? They will be signed out and unable to log in.');">
                                            <i class="bi bi-slash-circle me-1"></i>Suspend
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-outline-success btn-sm" onclick="return confirm('Activate user @user.FullName?');">
                                            <i class="bi bi-check-circle me-1"></i>Activate
                                        </button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
