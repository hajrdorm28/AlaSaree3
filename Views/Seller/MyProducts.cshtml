@model IEnumerable<Product>
@{
    ViewData["Title"] = "My Products";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1"><i class="bi bi-boxes text-primary me-2"></i>My Products Catalog</h2>
        <p class="text-muted small mb-0">Manage your product listings, stock levels, and pricing</p>
    </div>
    <a asp-action="CreateProduct" class="btn btn-primary-custom">
        <i class="bi bi-plus-circle-fill me-1"></i>Add New Product
    </a>
</div>

@if (!Model.Any())
{
    <div class="custom-card p-5 text-center my-4">
        <i class="bi bi-box display-3 text-muted mb-3"></i>
        <h4 class="fw-bold">No Products Listed Yet</h4>
        <p class="text-muted mb-4">Start selling on AlaSaree3 by listing your first product.</p>
        <a asp-action="CreateProduct" class="btn btn-primary-custom px-4 py-2">
            <i class="bi bi-plus-circle me-1"></i>Add First Product
        </a>
    </div>
}
else
{
    <div class="custom-card p-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock Level</th>
                        <th>Quick Update Stock</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@product.ImageUrl" alt="@product.Name" class="rounded border" style="width: 48px; height: 48px; object-fit: cover;" />
                                    <div>
                                        <h6 class="mb-0 fw-semibold">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="text-dark text-decoration-none">
                                                @product.Name
                                            </a>
                                        </h6>
                                        <small class="text-muted">Listed @product.CreatedAt.ToString("MMM dd, yyyy")</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge badge-category">@product.Category.Name</span></td>
                            <td class="fw-bold text-primary">$@product.Price.ToString("N2")</td>
                            <td>
                                @if (product.AvailableQuantity <= 0)
                                {
                                    <span class="badge bg-danger">Out of Stock (0)</span>
                                }
                                else if (product.AvailableQuantity <= 5)
                                {
                                    <span class="badge bg-warning text-dark">Low Stock (@product.AvailableQuantity)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@product.AvailableQuantity units</span>
                                }
                            </td>
                            <td>
                                <form asp-action="UpdateStock" method="post" class="d-flex align-items-center gap-1" style="max-width: 160px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="number" name="quantity" class="form-control form-control-sm" value="@product.AvailableQuantity" min="0" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="Save Stock">
                                        <i class="bi bi-check"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-outline-primary" title="Edit Product">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="DeleteProduct" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@product.Id" />
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Product">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
