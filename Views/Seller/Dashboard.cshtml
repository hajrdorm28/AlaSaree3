@model SellerDashboardViewModel
@{
    ViewData["Title"] = "Seller Hub Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1"><i class="bi bi-speedometer2 text-warning me-2"></i>Seller Hub Dashboard</h2>
        <p class="text-muted small mb-0">Overview of your storefront inventory, sales, and customer fulfillment</p>
    </div>
    <a asp-action="CreateProduct" class="btn btn-primary-custom">
        <i class="bi bi-plus-circle-fill me-1"></i>Add New Product
    </a>
</div>

<!-- Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-boxes"></i>
            </div>
            <div>
                <div class="text-muted small">My Products</div>
                <h3 class="fw-bold mb-0">@Model.TotalProducts</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon @(Model.LowStockProducts > 0 ? "bg-danger bg-opacity-10 text-danger" : "bg-success bg-opacity-10 text-success")">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <div class="text-muted small">Low Stock Alert</div>
                <h3 class="fw-bold mb-0 @(Model.LowStockProducts > 0 ? "text-danger" : "text-success")">@Model.LowStockProducts</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon bg-info bg-opacity-10 text-info">
                <i class="bi bi-truck"></i>
            </div>
            <div>
                <div class="text-muted small">Fulfillment Orders</div>
                <h3 class="fw-bold mb-0">@Model.TotalOrdersCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon bg-success bg-opacity-10 text-success">
                <i class="bi bi-currency-dollar"></i>
            </div>
            <div>
                <div class="text-muted small">Total Sales Revenue</div>
                <h3 class="fw-bold mb-0 text-success">$@Model.TotalSalesRevenue.ToString("N2")</h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Products -->
    <div class="col-lg-6">
        <div class="custom-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent Products</h5>
                <a asp-action="MyProducts" class="btn btn-outline-primary btn-sm">Manage All</a>
            </div>

            @if (!Model.RecentProducts.Any())
            {
                <p class="text-muted small text-center py-4">No products added yet. Click 'Add New Product' to list your first item.</p>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var prod in Model.RecentProducts)
                    {
                        <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded">
                            <div class="d-flex align-items-center gap-2">
                                <img src="@prod.ImageUrl" alt="@prod.Name" class="rounded border" style="width: 40px; height: 40px; object-fit: cover;" />
                                <div>
                                    <div class="fw-semibold small text-truncate" style="max-width: 200px;">@prod.Name</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@prod.Category.Name • Stock: @prod.AvailableQuantity</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-primary small">$@prod.Price.ToString("N2")</div>
                                <a asp-action="EditProduct" asp-route-id="@prod.Id" class="small text-decoration-none">Edit</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="col-lg-6">
        <div class="custom-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent Item Sales</h5>
                <a asp-action="MyOrders" class="btn btn-outline-primary btn-sm">View All Orders</a>
            </div>

            @if (!Model.RecentOrders.Any())
            {
                <p class="text-muted small text-center py-4">No recent orders for your products yet.</p>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var order in Model.RecentOrders)
                    {
                        <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded">
                            <div>
                                <div class="fw-semibold small">Order #@order.OrderId — @order.ProductName</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Customer: @order.CustomerName • Qty: @order.Quantity</div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-success small">$@order.LineTotal.ToString("N2")</div>
                                <span class="badge badge-status-@order.OrderStatus.ToString().ToLower() small" style="font-size: 0.7rem;">@order.OrderStatus</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
