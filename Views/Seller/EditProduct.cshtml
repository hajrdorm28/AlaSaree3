@model ProductEditViewModel
@{
    ViewData["Title"] = $"Edit — {Model.Name}";
}

<div class="custom-card p-4 mx-auto" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="h4 fw-bold mb-1"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Product</h2>
            <p class="text-muted small mb-0">Update listing details for #@Model.Id</p>
        </div>
        <a asp-action="MyProducts" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Products
        </a>
    </div>

    <form asp-action="EditProduct" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingImageUrl" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label fw-semibold small"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CategoryId" class="form-label fw-semibold small"></label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"></select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Price" class="form-label fw-semibold small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light">$</span>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                </div>
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AvailableQuantity" class="form-label fw-semibold small"></label>
                <input asp-for="AvailableQuantity" class="form-control" type="number" min="0" />
                <span asp-validation-for="AvailableQuantity" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold small"></label>
            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold small">Current Product Image</label>
            <div class="mb-2">
                <img src="@Model.ExistingImageUrl" alt="Current Image" class="rounded border p-1" style="max-height: 140px; max-width: 200px; object-fit: cover;" />
            </div>

            <label asp-for="ImageFile" class="form-label fw-semibold small"></label>
            <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            <div class="form-text small">Upload only if you want to replace current image (Max: 2MB).</div>
            <span asp-validation-for="ImageFile" class="text-danger small"></span>

            <div id="imagePreviewContainer" class="mt-3"></div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="MyProducts" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary-custom px-4">
                <i class="bi bi-save me-1"></i>Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
