@model ProductListViewModel
@{
    ViewData["Title"] = "Browse AlaSaree3 Products";
}

<div class="row g-4 mb-4">
    <!-- Sidebar Filters -->
    <div class="col-lg-3">
        <div class="custom-card p-4 sticky-top" style="top: 80px;">
            <h5 class="fw-bold mb-3"><i class="bi bi-funnel text-primary me-2"></i>Filter Catalog</h5>
            
            <form asp-controller="Product" asp-action="Index" method="get">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Search Products</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Keywords..." value="@Model.Search" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Category</label>
                    <select name="categoryId" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold small">Sort Order</label>
                    <select name="sortBy" class="form-select">
                        <option value="newest" selected="@(Model.SortBy == "newest" || string.IsNullOrEmpty(Model.SortBy))">Newest Arrivals</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                        <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Product Name (A-Z)</option>
                    </select>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-funnel-fill me-1"></i>Apply Filters
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        Reset All
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Product Grid & Pagination -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0">Products <span class="text-muted fs-6 fw-normal">(@Model.TotalItems items found)</span></h4>
            <div class="text-muted small">Page @Model.CurrentPage of @(Model.TotalPages > 0 ? Model.TotalPages : 1)</div>
        </div>

        @if (!Model.Products.Any())
        {
            <div class="custom-card p-5 text-center my-4">
                <i class="bi bi-inbox display-3 text-muted mb-3"></i>
                <h4 class="fw-bold">No Products Found</h4>
                <p class="text-muted">No products matched your search or category filter. Try clearing filters.</p>
                <a asp-action="Index" class="btn btn-primary-custom btn-sm">View All Products</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                @foreach (var product in Model.Products)
                {
                    var reviewCount = product.Reviews.Count;
                    var avgRating = reviewCount > 0 ? Math.Round(product.Reviews.Average(r => r.Rating), 1) : 0;

                    <div class="col">
                        <div class="custom-card h-100 d-flex flex-column">
                            <div class="product-img-container">
                                <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                                <span class="badge badge-category position-absolute top-0 start-0 m-3 shadow-sm">
                                    @product.Category.Name
                                </span>
                                @if (User.Identity?.IsAuthenticated == true && product.SellerId != User.FindFirstValue(ClaimTypes.NameIdentifier))
                                {
                                    bool isInWishlist = Model.WishlistProductIds.Contains(product.Id);
                                    <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="position-absolute top-0 end-0 m-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-sm rounded-circle shadow-sm @(isInWishlist ? "btn-danger" : "btn-light")" style="width: 34px; height: 34px;" title="@(isInWishlist ? "Remove from Wishlist" : "Add to Wishlist")">
                                            <i class="bi @(isInWishlist ? "bi-heart-fill" : "bi-heart") @(isInWishlist ? "" : "text-danger")"></i>
                                        </button>
                                    </form>
                                }
                                @if (product.AvailableQuantity <= 0)
                                {
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-5 pt-1 shadow-sm">Out of Stock</span>
                                }
                                else if (product.AvailableQuantity <= 5)
                                {
                                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-5 pt-1 shadow-sm">Only @product.AvailableQuantity left</span>
                                }
                            </div>

                            <div class="card-body p-3 d-flex flex-column flex-grow-1">
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <span class="star-rating small">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Round(avgRating))
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star star-rating-empty"></i>
                                            }
                                        }
                                    </span>
                                    <span class="text-muted small">(@reviewCount)</span>
                                </div>

                                <h5 class="card-title h6 fw-bold text-truncate mb-1">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="text-dark text-decoration-none">
                                        @product.Name
                                    </a>
                                </h5>

                                <p class="text-muted small mb-2 text-truncate" style="max-height: 2.4em;">
                                    @product.Description
                                </p>

                                <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="small text-muted d-block" style="font-size: 0.75rem;">Seller: @(product.Seller?.FullName ?? "Vendor")</span>
                                        <span class="fw-bold text-primary fs-5">$@product.Price.ToString("N2")</span>
                                    </div>
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">
                                        View <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Product navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-sortBy="@Model.SortBy">Previous</a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@p"
                                   asp-route-search="@Model.Search"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-sortBy="@Model.SortBy">@p</a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-sortBy="@Model.SortBy">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>
