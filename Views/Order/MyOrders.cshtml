@model IEnumerable<Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1"><i class="bi bi-box-seam text-primary me-2"></i>My Orders</h2>
        <p class="text-muted small mb-0">Track and manage your AlaSaree3 purchases</p>
    </div>
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-bag-plus me-1"></i>New Order
    </a>
</div>

@if (!Model.Any())
{
    <div class="custom-card p-5 text-center my-4">
        <i class="bi bi-receipt-cutoff display-3 text-muted mb-3"></i>
        <h4 class="fw-bold">No Orders Yet</h4>
        <p class="text-muted mb-4">You haven't made any purchases on AlaSaree3 yet.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-primary-custom px-4 py-2">
            <i class="bi bi-shop me-1"></i>Browse AlaSaree3
        </a>
    </div>
}
else
{
    <div class="custom-card p-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Items Count</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var badgeClass = order.Status switch
                        {
                            OrderStatus.Pending => "badge-status-pending",
                            OrderStatus.Confirmed => "badge-status-confirmed",
                            OrderStatus.Shipped => "badge-status-shipped",
                            OrderStatus.Delivered => "badge-status-delivered",
                            OrderStatus.Cancelled => "badge-status-cancelled",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="fw-bold text-primary">#@order.Id</td>
                            <td class="small text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td class="small">@order.Items.Sum(i => i.Quantity) items</td>
                            <td class="fw-bold">$@order.TotalAmount.ToString("N2")</td>
                            <td>
                                <span class="badge @badgeClass px-3 py-2 rounded-pill">
                                    @order.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
