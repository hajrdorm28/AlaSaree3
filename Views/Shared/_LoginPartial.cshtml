@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var roles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var primaryRole = roles.FirstOrDefault() ?? "Customer";

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-weight: 700; font-size: 0.85rem;">
                @(currentUser?.FullName?.Length > 0 ? currentUser.FullName.Substring(0, 1).ToUpper() : "U")
            </div>
            <span>@(currentUser?.FullName ?? User.Identity?.Name)</span>
            <span class="badge @(primaryRole == "Admin" ? "bg-danger" : primaryRole == "Seller" ? "bg-warning text-dark" : "bg-info text-dark")" style="font-size: 0.7rem;">
                @primaryRole
            </span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" aria-labelledby="userDropdown">
            <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
            
            @if (User.IsInRole("Admin"))
            {
                <li><a class="dropdown-item py-2 text-primary fw-semibold" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
            }
            @if (User.IsInRole("Seller"))
            {
                <li><a class="dropdown-item py-2 text-warning fw-semibold" asp-controller="Seller" asp-action="Dashboard"><i class="bi bi-shop me-2"></i>Seller Dashboard</a></li>
            }
                @if (!User.IsInRole("Seller") && !User.IsInRole("Admin"))
                {
                    <li><a class="dropdown-item py-2 text-success" asp-controller="Seller" asp-action="RequestSeller"><i class="bi bi-briefcase me-2"></i>Become a Seller</a></li>
                }
                @if (!User.IsInRole("Admin"))
                {
                    <li><a class="dropdown-item py-2" asp-controller="Order" asp-action="MyOrders"><i class="bi bi-box-seam me-2"></i>My Orders</a></li>
                    <li><a class="dropdown-item py-2" asp-controller="Wishlist" asp-action="Index"><i class="bi bi-heart me-2"></i>My Wishlist</a></li>
                }

            <li><hr class="dropdown-divider"></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item py-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-sm btn-primary-custom" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus me-1"></i>Register</a>
    </li>
}
</ul>
