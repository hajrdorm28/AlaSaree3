@model CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1"><i class="bi bi-cart3 text-primary me-2"></i>My Shopping Cart</h2>
        <p class="text-muted small mb-0">Review your selected AlaSaree3 items</p>
    </div>

    @if (Model.Items.Any())
    {
        <form asp-action="Clear" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to clear your shopping cart?');">
                <i class="bi bi-trash me-1"></i>Clear Cart
            </button>
        </form>
    }
</div>

@if (!Model.Items.Any())
{
    <div class="custom-card p-5 text-center my-4">
        <i class="bi bi-cart-x display-3 text-muted mb-3"></i>
        <h4 class="fw-bold">Your Cart is Empty</h4>
        <p class="text-muted mb-4">Looks like you haven't added any products to your cart yet.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-primary-custom px-4 py-2">
            <i class="bi bi-bag-plus me-1"></i>Explore Products
        </a>
    </div>
}
else
{
    @if (Model.HasInvalidItems)
    {
        <div class="alert alert-warning mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Some products in your cart have stock adjustments. Please check requested quantities before checkout.
        </div>
    }

    <div class="row g-4">
        <!-- Cart Items List -->
        <div class="col-lg-8">
            <div class="custom-card p-4">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Unit Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@item.ProductImageUrl" alt="@item.ProductName" class="rounded border" style="width: 64px; height: 64px; object-fit: cover;" />
                                            <div>
                                                <h6 class="mb-0 fw-semibold">
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="text-dark text-decoration-none">
                                                        @item.ProductName
                                                    </a>
                                                </h6>
                                                <small class="text-muted d-block">Vendor: @item.SellerName</small>
                                                @if (item.IsOutOfStock)
                                                {
                                                    <span class="badge bg-danger">Out of Stock</span>
                                                }
                                                else if (item.HasInsufficientStock)
                                                {
                                                    <span class="badge bg-warning text-dark">Only @item.AvailableStock available</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="fw-semibold">$@item.UnitPrice.ToString("N2")</td>
                                    <td>
                                        <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-1" style="max-width: 140px;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cartItemId" value="@item.Id" />
                                            <input type="number" name="quantity" class="form-control form-control-sm text-center" value="@item.Quantity" min="1" max="@item.AvailableStock" onchange="this.form.submit()" />
                                        </form>
                                    </td>
                                    <td class="fw-bold text-primary">$@item.LineTotal.ToString("N2")</td>
                                    <td class="text-end">
                                        <form asp-action="Remove" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cartItemId" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle" title="Remove Item">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Order Summary Card -->
        <div class="col-lg-4">
            <div class="custom-card p-4">
                <h5 class="fw-bold mb-3">Order Summary</h5>
                <div class="d-flex justify-content-between mb-2 text-muted small">
                    <span>Total Items</span>
                    <span class="fw-semibold text-dark">@Model.TotalItemCount units</span>
                </div>
                <div class="d-flex justify-content-between mb-2 text-muted small">
                    <span>Subtotal</span>
                    <span class="fw-semibold text-dark">$@Model.SubTotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-3 text-muted small">
                    <span>Estimated Shipping</span>
                    <span class="text-success fw-semibold">FREE</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-4">
                    <span class="fw-bold fs-5">Total</span>
                    <span class="fw-bold text-primary fs-4">$@Model.Total.ToString("N2")</span>
                </div>

                @if (Model.HasInvalidItems)
                {
                    <button class="btn btn-secondary w-100 py-2 mb-3" disabled>
                        <i class="bi bi-lock me-1"></i>Resolve Stock Issues to Checkout
                    </button>
                }
                else
                {
                    <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary-custom w-100 py-2 mb-3">
                        <i class="bi bi-shield-check me-1"></i>Proceed to Checkout
                    </a>
                }

                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-arrow-left me-1"></i>Continue Shopping
                </a>
            </div>
        </div>
    </div>
}
