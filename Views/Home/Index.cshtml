@model ProductListViewModel
@{
    ViewData["Title"] = "AlaSaree3 — Secure Multi-Vendor Platform";
}

<!-- Hero Banner -->
<div class="hero-banner mb-5">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <span class="badge bg-primary bg-opacity-25 text-info px-3 py-2 rounded-pill mb-3 fw-semibold">
                <i class="bi bi-shield-lock-fill me-1"></i> Start Selling As A verified Seller At AlaSaree3
            </span>
            <h1 class="display-5 fw-extrabold mb-3">Discover Quality Products from Top Independent Vendors</h1>
            <p class="lead text-light text-opacity-75 mb-4">
                A modern multi-vendor AlaSaree3 featuring verified seller storefronts, secure atomic checkout, purchase-verified reviews, and real-time inventory management.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary-custom px-4 py-2">
                    <i class="bi bi-bag-check me-1"></i>Start Shopping
                </a>
                @if (User.Identity?.IsAuthenticated != true || (!User.IsInRole("Seller") && !User.IsInRole("Admin")))
                {
                    <a asp-controller="Seller" asp-action="RequestSeller" class="btn btn-outline-light px-4 py-2">
                        <i class="bi bi-shop me-1"></i>Sell on AlaSaree3
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block text-center">
            <img src="~/images/hero-alasaree3.jpg" alt="AlaSaree3 Showcase" class="img-fluid rounded-4 shadow-lg border border-secondary border-opacity-50" style="max-height: 280px; object-fit: cover;" />
        </div>
    </div>
</div>

<!-- Search & Quick Category Filter -->
<div class="custom-card p-4 mb-5">
    <form asp-controller="Product" asp-action="Index" method="get" class="row g-3 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search by product name or keyword..." value="@Model.Search" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary-custom w-100">
                <i class="bi bi-funnel me-1"></i>Filter Catalog
            </button>
        </div>
    </form>
</div>

<!-- Featured Products Section -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1">Featured AlaSaree3 Products</h2>
        <p class="text-muted small mb-0">Browse latest arrivals from our approved vendors</p>
    </div>
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-sm">
        View All Catalog <i class="bi bi-arrow-right ms-1"></i>
    </a>
</div>

@if (!Model.Products.Any())
{
    <div class="custom-card p-5 text-center my-4">
        <i class="bi bi-box-seam display-3 text-muted mb-3"></i>
        <h4 class="fw-bold">No Products Found</h4>
        <p class="text-muted">There are currently no products matching your search criteria.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-primary-custom btn-sm">Clear Filters</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-5">
        @foreach (var product in Model.Products)
        {
            var reviewCount = product.Reviews.Count;
            var avgRating = reviewCount > 0 ? Math.Round(product.Reviews.Average(r => r.Rating), 1) : 0;

            <div class="col">
                <div class="custom-card h-100 d-flex flex-column position-relative">
                    <div class="product-img-container">
                        <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                        <span class="badge badge-category position-absolute top-0 start-0 m-3 shadow-sm">
                            @product.Category.Name
                        </span>
                        @if (product.AvailableQuantity <= 0)
                        {
                            <span class="badge bg-danger position-absolute top-0 end-0 m-3 shadow-sm">Out of Stock</span>
                        }
                        else if (product.AvailableQuantity <= 5)
                        {
                            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 shadow-sm">Only @product.AvailableQuantity left</span>
                        }
                    </div>

                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <span class="star-rating small">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(avgRating))
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star star-rating-empty"></i>
                                    }
                                }
                            </span>
                            <span class="text-muted small">(@reviewCount)</span>
                        </div>

                        <h5 class="card-title h6 fw-bold text-truncate mb-1">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="text-dark text-decoration-none stretched-link">
                                @product.Name
                            </a>
                        </h5>

                        <p class="text-muted small mb-2 text-truncate" style="max-height: 2.4em;">
                            @product.Description
                        </p>

                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                            <div>
                                <span class="small text-muted d-block" style="font-size: 0.75rem;">Seller: @(product.Seller?.FullName ?? "Vendor")</span>
                                <span class="fw-bold text-primary fs-5">$@product.Price.ToString("N2")</span>
                            </div>
                            <span class="btn btn-sm btn-outline-primary rounded-circle" style="pointer-events: none;">
                                <i class="bi bi-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Feature Highlights -->
<div class="row g-4 my-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1">Secure Multi-Vendor Architecture</h6>
                <p class="small text-muted mb-0">Role-based access control with resource-level ownership enforcement.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon bg-success bg-opacity-10 text-success">
                <i class="bi bi-cart-check"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1">Atomic Transactional Checkout</h6>
                <p class="small text-muted mb-0">Prevents overselling with database transactions and live stock checks.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-patch-check"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1">Verified Purchase Reviews</h6>
                <p class="small text-muted mb-0">Only verified customers who purchased items can leave ratings and feedback.</p>
            </div>
        </div>
    </div>
</div>