@model IEnumerable<Order>
@{
    ViewData["Title"] = "All Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold mb-1"><i class="bi bi-receipt text-primary me-2"></i>Platform Orders</h2>
        <p class="text-muted small mb-0">System-wide customer orders, status tracking, and order fulfillment</p>
    </div>
</div>

<div class="custom-card p-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    var badgeClass = order.Status switch
                    {
                        OrderStatus.Pending => "badge-status-pending",
                        OrderStatus.Confirmed => "badge-status-confirmed",
                        OrderStatus.Shipped => "badge-status-shipped",
                        OrderStatus.Delivered => "badge-status-delivered",
                        OrderStatus.Cancelled => "badge-status-cancelled",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td class="fw-bold text-primary">#@order.Id</td>
                        <td class="small text-muted">@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                        <td>
                            <div class="fw-semibold small">@order.Customer.FullName</div>
                            <div class="text-muted" style="font-size: 0.75rem;">@order.Customer.Email</div>
                        </td>
                        <td class="small">@order.Items.Sum(i => i.Quantity) items</td>
                        <td class="fw-bold text-dark">$@order.TotalAmount.ToString("N2")</td>
                        <td>
                            <span class="badge @badgeClass px-3 py-2 rounded-pill">
                                @order.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye me-1"></i>Manage Order
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
