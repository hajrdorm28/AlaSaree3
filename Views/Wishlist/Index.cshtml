@model WishlistViewModel
@{
    ViewData["Title"] = "My Wishlist";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1"><i class="bi bi-heart-fill text-danger me-2"></i>My Wishlist</h2>
        <p class="text-muted small mb-0">Saved products for future purchases</p>
    </div>
    <span class="badge bg-secondary rounded-pill px-3 py-2">@Model.TotalItems Saved Items</span>
</div>

@if (!Model.Items.Any())
{
    <div class="custom-card p-5 text-center my-4">
        <i class="bi bi-heartbreak display-3 text-muted mb-3"></i>
        <h4 class="fw-bold">Your Wishlist is Empty</h4>
        <p class="text-muted mb-4">Explore our AlaSaree3 catalog and click the heart icon on any product to save it here.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-primary-custom px-4 py-2">
            <i class="bi bi-compass me-1"></i>Discover Products
        </a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <div class="custom-card h-100 d-flex flex-column">
                    <div class="product-img-container">
                        <img src="@item.ProductImageUrl" alt="@item.ProductName" loading="lazy" />
                        <span class="badge badge-category position-absolute top-0 start-0 m-3 shadow-sm">
                            @item.CategoryName
                        </span>
                        
                        <form asp-action="Remove" method="post" class="position-absolute top-0 end-0 m-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="btn btn-light btn-sm rounded-circle shadow-sm text-danger" title="Remove from Wishlist">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>

                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <h5 class="card-title h6 fw-bold text-truncate mb-1">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="text-dark text-decoration-none">
                                @item.ProductName
                            </a>
                        </h5>

                        <div class="mb-3">
                            <span class="fw-bold text-primary fs-5">$@item.Price.ToString("N2")</span>
                            <span class="d-block small @(item.InStock ? "text-success" : "text-danger")">
                                @(item.InStock ? $"{item.AvailableQuantity} in stock" : "Out of stock")
                            </span>
                        </div>

                        <div class="mt-auto pt-2 border-top">
                            @if (item.InStock)
                            {
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-primary-custom btn-sm w-100">
                                        <i class="bi bi-cart-plus me-1"></i>Move to Cart
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm w-100" disabled>
                                    Out of Stock
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
