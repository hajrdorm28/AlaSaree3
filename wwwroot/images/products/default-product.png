<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366f1"/>
      <stop offset="100%" stop-color="#3b82f6"/>
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#bg)"/>
  <circle cx="300" cy="180" r="70" fill="url(#accent)" opacity="0.2"/>
  <path d="M260 210 L300 130 L340 210 Z" fill="none" stroke="#6366f1" stroke-width="4" stroke-linejoin="round"/>
  <rect x="250" y="210" width="100" height="20" rx="4" fill="#3b82f6" opacity="0.8"/>
  <circle cx="280" cy="170" r="10" fill="#38bdf8"/>
